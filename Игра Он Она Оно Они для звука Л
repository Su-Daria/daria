<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#8fd3f4">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Посели картинки в домики</title>
<style>
:root{
  --blue:#59b7e8; --blue-d:#3d95c7;
  --mint:#57cfae; --mint-d:#37ac8c;
  --yellow:#ffcf5c; --yellow-d:#efb232;
  --lilac:#b79bee; --lilac-d:#9478d6;
  --coral:#ff8f86; --coral-d:#e86b60;
  --ink:#33445c; --ink-soft:#5c6f8a;
  --card:#ffffff;
  --bg1:#e8f7ff; --bg2:#f3f0ff; --bg3:#fff6e6;
  --shadow:0 10px 24px rgba(51,68,92,.14);
  --radius:26px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;margin:0;padding:0;}
body{
  font-family:'Comic Sans MS','Chalkboard SE','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  color:var(--ink);
  background:linear-gradient(170deg,var(--bg1) 0%,var(--bg2) 55%,var(--bg3) 100%);
  overscroll-behavior:none;
  overflow:hidden;
  -webkit-user-select:none;user-select:none;-webkit-touch-callout:none;
  touch-action:manipulation;
}
button{font-family:inherit;color:inherit;border:0;background:none;padding:0;cursor:pointer;touch-action:manipulation;}
img{display:block;-webkit-user-drag:none;user-drag:none;pointer-events:none;}
#app{
  position:fixed;inset:0;
  display:flex;flex-direction:column;
  padding:calc(env(safe-area-inset-top) + 8px) calc(env(safe-area-inset-right) + 10px) calc(env(safe-area-inset-bottom) + 8px) calc(env(safe-area-inset-left) + 10px);
  overflow:hidden;
}
.screen{display:none;flex:1 1 auto;min-height:0;flex-direction:column;align-items:center;width:100%;}
.screen.active{display:flex;}

/* ---------- typography ---------- */
h1{
  margin:0;text-align:center;
  font-size:clamp(20px,5.4vw,38px);
  line-height:1.12;letter-spacing:.5px;
  color:#2f5d8a;
  text-shadow:0 2px 0 #fff,0 4px 10px rgba(47,93,138,.16);
}
h1 .l1{color:var(--coral-d);}
h1 .l2{color:var(--mint-d);}
.subtitle{
  margin:6px 0 0;text-align:center;
  font-size:clamp(12px,3.3vw,17px);
  color:var(--ink-soft);line-height:1.35;max-width:36em;
}
/* ---------- start screen ---------- */
#screenStart{justify-content:center;gap:6px;}
.start-scene{width:100%;max-width:760px;margin:clamp(4px,2vh,18px) 0;flex:0 1 auto;min-height:0;display:flex;align-items:flex-end;}
.start-scene svg{width:100%;height:auto;max-height:38vh;}
.big-btn{
  margin-top:clamp(6px,2vh,18px);
  padding:clamp(12px,3.2vw,18px) clamp(28px,8vw,56px);
  font-size:clamp(17px,4.6vw,26px);font-weight:700;letter-spacing:1px;
  color:#fff;border-radius:999px;
  background:linear-gradient(180deg,#ffd873,var(--yellow-d));
  box-shadow:0 6px 0 #d99a1c,0 12px 22px rgba(216,154,28,.35);
  transition:transform .09s ease,box-shadow .09s ease;
}
.big-btn:active,.big-btn.pressed{transform:translateY(5px);box-shadow:0 1px 0 #d99a1c,0 4px 10px rgba(216,154,28,.3);}
.creds{margin-top:10px;font-size:clamp(10px,2.6vw,13px);color:#8fa2b8;text-align:center;}

/* ---------- game screen ---------- */
.topbar{width:100%;max-width:1000px;display:flex;flex-direction:column;align-items:center;flex:0 0 auto;}
.progress-pill{
  margin-top:8px;padding:5px 16px;border-radius:999px;
  background:#fff;box-shadow:var(--shadow);
  font-size:clamp(12px,3.2vw,17px);font-weight:700;color:var(--ink);
  white-space:nowrap;
}
.progress-pill b{color:var(--blue-d);}
.progress-bar{
  margin-top:8px;width:min(560px,88%);height:10px;border-radius:999px;
  background:#ffffffcc;box-shadow:inset 0 2px 5px rgba(51,68,92,.12);overflow:hidden;
}
.progress-bar > i{display:block;height:100%;width:0;border-radius:999px;
  background:linear-gradient(90deg,var(--mint),var(--blue));transition:width .45s ease;}

.stage{
  flex:1 1 auto;min-height:0;width:100%;max-width:1000px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(4px,1.4vh,14px);
}
/* card */
.card{
  position:relative;width:min(86vw,340px);
  aspect-ratio:1/1;max-height:min(46vh,340px);
  background:var(--card);border-radius:var(--radius);
  box-shadow:0 14px 30px rgba(51,68,92,.18),inset 0 0 0 6px #fff;
  display:flex;align-items:center;justify-content:center;
  padding:14px;flex:0 1 auto;
}
.card-inner{width:100%;height:100%;border-radius:18px;overflow:hidden;
  background:radial-gradient(circle at 50% 35%,#f7fcff 0%,#eaf4fb 60%,#e2eef8 100%);
  display:flex;align-items:center;justify-content:center;}
.card-inner img{width:100%;height:100%;object-fit:contain;transition:transform .3s ease;}
.card.pop .card-inner img{transform:scale(1.06);}
.card .ribbon{
  position:absolute;top:-12px;left:50%;transform:translateX(-50%);
  background:linear-gradient(180deg,#ffe08a,var(--yellow-d));
  color:#7a4a00;font-size:clamp(11px,2.9vw,15px);font-weight:700;
  padding:5px 16px;border-radius:999px;box-shadow:0 4px 10px rgba(0,0,0,.12);white-space:nowrap;
}
.card.shake{animation:shakeSoft .45s ease;}
@keyframes shakeSoft{
  0%,100%{transform:translateX(0) rotate(0);}
  20%{transform:translateX(-7px) rotate(-1deg);}
  45%{transform:translateX(6px) rotate(1deg);}
  70%{transform:translateX(-4px) rotate(0);}
}
/* speaker */
.card-controls{display:flex;flex-direction:column;align-items:center;gap:8px;flex:0 0 auto;}
.speaker-btn{
  width:clamp(52px,14vw,64px);height:clamp(52px,14vw,64px);border-radius:50%;
  background:linear-gradient(180deg,#8fd8f7,var(--blue));
  box-shadow:0 5px 0 var(--blue-d),0 10px 18px rgba(61,149,199,.35);
  display:flex;align-items:center;justify-content:center;
  transition:transform .09s ease,box-shadow .09s ease;
}
.speaker-btn:active,.speaker-btn.pressed{transform:translateY(4px);box-shadow:0 1px 0 var(--blue-d),0 4px 8px rgba(61,149,199,.3);}
.speaker-btn svg{width:58%;height:58%;}
.hint-line{
  margin:0;text-align:center;font-size:clamp(12px,3.2vw,16px);color:var(--ink-soft);font-weight:700;
}
/* feedback */
.feedback{
  min-height:clamp(38px,6.4vh,54px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  text-align:center;flex:0 0 auto;
}
.feedback .msg{font-size:clamp(16px,4.4vw,24px);font-weight:700;opacity:0;transform:translateY(6px);transition:opacity .2s,transform .2s;}
.feedback .model{font-size:clamp(13px,3.6vw,19px);font-weight:700;color:var(--mint-d);opacity:0;transform:translateY(6px);transition:opacity .2s,transform .2s;}
.feedback.show .msg,.feedback.show .model{opacity:1;transform:none;}
.feedback.good .msg{color:var(--mint-d);}
.feedback.try .msg{color:var(--coral-d);}

/* houses */
.houses{
  width:100%;max-width:1000px;flex:0 0 auto;
  display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(6px,1.4vw,16px);
  padding-top:2px;
}
.house{
  position:relative;border-radius:22px;padding:6px 4px 8px;
  background:#ffffffcc;box-shadow:var(--shadow);
  display:flex;flex-direction:column;align-items:center;
  transition:transform .12s ease,box-shadow .12s ease,background .2s;
}
.house:active,.house.pressed{transform:translateY(4px) scale(.98);box-shadow:0 4px 10px rgba(51,68,92,.18);}
.house svg{width:100%;height:auto;max-height:min(20vh,150px);display:block;}
.house .tenants{
  margin-top:4px;min-height:clamp(24px,5vw,34px);
  display:flex;flex-wrap:wrap;gap:4px;justify-content:center;align-items:center;padding:0 2px;
}
.house .tenants img{
  width:clamp(22px,5.4vw,32px);height:clamp(22px,5.4vw,32px);
  border-radius:8px;background:#fff;box-shadow:0 2px 5px rgba(51,68,92,.18);
  object-fit:cover;animation:pop .35s cubic-bezier(.2,1.5,.4,1);
}
@keyframes pop{from{transform:scale(.2);opacity:0;}to{transform:scale(1);opacity:1;}}
.house.glow{background:#fff;box-shadow:0 0 0 5px rgba(255,207,92,.75),0 12px 26px rgba(255,180,50,.4);}
.house.glow svg{animation:houseBounce .6s ease;}
@keyframes houseBounce{0%{transform:translateY(0) scale(1);}35%{transform:translateY(-10px) scale(1.05);}70%{transform:translateY(0) scale(.98);}100%{transform:translateY(0) scale(1);}}
.house.hint{animation:hintPulse 1s ease-in-out 3;}
@keyframes hintPulse{0%,100%{box-shadow:var(--shadow);}50%{box-shadow:0 0 0 6px rgba(183,155,238,.8),0 12px 24px rgba(183,155,238,.5);}}
.house.bad{animation:badWobble .45s ease;}
@keyframes badWobble{0%,100%{transform:translateX(0);}25%{transform:translateX(-5px);}75%{transform:translateX(5px);}}

/* flying clone */
.flyer{position:fixed;z-index:60;border-radius:16px;overflow:hidden;background:#fff;
  box-shadow:0 12px 26px rgba(51,68,92,.28);pointer-events:none;}

/* ---------- final screen ---------- */
#screenFinal{justify-content:flex-start;gap:4px;overflow:hidden;}
.final-title{
  margin:0;text-align:center;font-size:clamp(19px,5.2vw,34px);font-weight:700;color:#2f5d8a;
  text-shadow:0 2px 0 #fff;
}
.final-houses{
  width:100%;max-width:1000px;margin-top:6px;
  display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(6px,1.4vw,14px);flex:0 0 auto;
}
.final-houses .house{background:#ffffffe6;padding:6px 6px 10px;}
.final-houses .house svg{max-height:min(17vh,132px);}
.final-houses .house .tenants img{width:clamp(20px,4.6vw,30px);height:clamp(20px,4.6vw,30px);}
.medal-wrap{flex:0 1 auto;min-height:0;display:flex;align-items:center;justify-content:center;gap:clamp(8px,2vw,20px);margin-top:clamp(4px,1.4vh,12px);width:100%;max-width:820px;}
.medal{flex:0 0 auto;width:clamp(76px,20vw,132px);animation:medalFloat 2.6s ease-in-out infinite;}
@keyframes medalFloat{0%,100%{transform:translateY(0) rotate(-2deg);}50%{transform:translateY(-8px) rotate(2deg);}}
.medal-text{text-align:center;}
.medal-text .t{font-size:clamp(15px,4.2vw,26px);font-weight:700;color:var(--coral-d);}
.medal-text .s{font-size:clamp(11px,3vw,16px);color:var(--ink-soft);margin-top:2px;}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:50;}

@media (max-width:760px){
  .houses,.final-houses{grid-template-columns:repeat(2,1fr);}
  .house svg{max-height:min(17vh,130px);}
  .card{width:min(78vw,300px);max-height:min(38vh,300px);}
}
@media (max-height:560px){
  h1{font-size:clamp(17px,4.4vw,24px);}
  .card{max-height:34vh;}
  .house svg{max-height:150px;}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;}
}
</style>
</head>
<body>
<div id="app">

  <!-- ============ START ============ -->
  <section class="screen active" id="screenStart">
    <h1><span class="l1">ПОСЕЛИ</span> КАРТИНКИ <span class="l2">В ДОМИКИ</span></h1>
    <p class="subtitle">Рассмотри картинку. Назови её и выбери подходящий домик: <b>ОН</b>, <b>ОНА</b>, <b>ОНО</b> или <b>ОНИ</b>.</p>
    <div class="start-scene" id="startScene"></div>
    <button class="big-btn" id="btnStart" type="button">НАЧАТЬ ИГРУ</button>
    <p class="creds">Звук [Л] · род и число существительных · 16 карточек</p>
  </section>

  <!-- ============ GAME ============ -->
  <section class="screen" id="screenGame">
    <div class="topbar">
      <h1><span class="l1">ПОСЕЛИ</span> КАРТИНКИ <span class="l2">В ДОМИКИ</span></h1>
      <div class="progress-pill">Карточка <b id="cardNum">1</b> из 16</div>
      <div class="progress-bar"><i id="progressFill"></i></div>
    </div>

    <div class="stage">
      <div class="card" id="card">
        <span class="ribbon" id="cardRibbon">Кто это?</span>
        <div class="card-inner"><img id="cardImg" alt="Картинка для игры" src=""></div>
      </div>
      <div class="card-controls">
        <button class="speaker-btn" id="btnSpeak" type="button" aria-label="Послушать слово">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h3.2L12 4.6v14.8L7.2 15H4z" fill="#fff"/><path d="M15.4 8.2a5 5 0 0 1 0 7.6" stroke="#fff" stroke-width="1.9" stroke-linecap="round" fill="none"/><path d="M17.9 5.6a8.4 8.4 0 0 1 0 12.8" stroke="#fff" stroke-width="1.9" stroke-linecap="round" fill="none"/></svg>
        </button>
        <p class="hint-line">Кто это? Что это? Выбери домик</p>
      </div>
      <div class="feedback" id="feedback">
        <div class="msg" id="fbMsg"></div>
        <div class="model" id="fbModel"></div>
      </div>
    </div>

    <div class="houses" id="houses"></div>
  </section>

  <!-- ============ FINAL ============ -->
  <section class="screen" id="screenFinal">
    <h2 class="final-title">Все картинки нашли свои домики!</h2>
    <div class="final-houses" id="finalHouses"></div>
    <div class="medal-wrap">
      <svg class="medal" viewBox="0 0 120 140" aria-hidden="true">
        <path d="M30 8 L48 62 L60 46 L72 62 L90 8 Z" fill="#ff8f86"/>
        <path d="M48 62 L60 46 L72 62 L60 56 Z" fill="#e86b60"/>
        <circle cx="60" cy="88" r="40" fill="#ffcf5c"/>
        <circle cx="60" cy="88" r="32" fill="#ffe08a"/>
        <circle cx="60" cy="88" r="25" fill="#ffcf5c"/>
        <path d="M60 70 l5.6 11.6 12.6 1.8 -9.1 8.9 2.1 12.6 -11.2 -5.9 -11.2 5.9 2.1 -12.6 -9.1 -8.9 12.6 -1.8 z" fill="#fff"/>
      </svg>
      <div class="medal-text">
        <div class="t">Помощник по домикам</div>
        <div class="s">Ты помог всем картинкам найти свой дом!</div>
      </div>
    </div>
    <button class="big-btn" id="btnRestart" type="button">ИГРАТЬ ЕЩЁ РАЗ</button>
  </section>
</div>
<canvas id="confetti"></canvas>

<script>
(function(){
"use strict";
/* ===== данные ===== */
var IMAGES = {"stul":"data:image/jpeg;base64,","kloun":"data:image/jpeg;base64,","dyatel":"data:image/jpeg;base64,","kolodec":"data:image/jpeg;base64,","molotok":"data:image/jpeg;base64,","slon":"data:image/jpeg;base64,","globus":"data:image/jpeg;base64,","luna":"data:image/jpeg;base64,","lastochka":"data:image/jpeg;base64,","palatka":"data:image/jpeg;base64,","lukoshko":"data:image/jpeg;base64,","moloko":"data:image/jpeg;base64,","boloto":"data:image/jpeg;base64,","fialki":"data:image/jpeg;base64,","lyzhi":"data:image/jpeg;base64,","nosilki":"data:image/jpeg;base64,"};
var AUDIO = {"stul":"data:audio/mpeg;base64,","kloun":"data:audio/mpeg;base64,","dyatel":"data:audio/mpeg;base64,","kolodec":"data:audio/mpeg;base64,","molotok":"data:audio/mpeg;base64,","slon":"data:audio/mpeg;base64,","globus":"data:audio/mpeg;base64,","luna":"data:audio/mpeg;base64,","lastochka":"data:audio/mpeg;base64,","palatka":"data:audio/mpeg;base64,"};var SILENT = "data:audio/wav;base64,";

var HOUSES = [
  {id:'he',   label:'ОН',  key:'he',   my:'мой', color:'#59b7e8', dark:'#3d95c7', roof:'#3d95c7', light:'#9fdcff'},
  {id:'she',  label:'ОНА', key:'she',  my:'моя', color:'#ff8f86', dark:'#e86b60', roof:'#e86b60', light:'#ffc0b9'},
  {id:'it',   label:'ОНО', key:'it',   my:'моё', color:'#57cfae', dark:'#37ac8c', roof:'#37ac8c', light:'#a5ecd8'},
  {id:'they', label:'ОНИ', key:'they', my:'мои', color:'#b79bee', dark:'#9478d6', roof:'#9478d6', light:'#dcd0ff'}
];

var WORDS = [
  {id:'stul',      word:'Стул',      house:'he'},
  {id:'kloun',     word:'Клоун',     house:'he'},
  {id:'dyatel',    word:'Дятел',     house:'he'},
  {id:'kolodec',   word:'Колодец',   house:'he'},
  {id:'molotok',   word:'Молоток',   house:'he'},
  {id:'slon',      word:'Слон',      house:'he'},
  {id:'globus',    word:'Глобус',    house:'he'},
  {id:'luna',      word:'Луна',      house:'she'},
  {id:'lastochka', word:'Ласточка',  house:'she'},
  {id:'palatka',   word:'Палатка',   house:'she'},
  {id:'lukoshko',  word:'Лукошко',   house:'it'},
  {id:'moloko',    word:'Молоко',    house:'it'},
  {id:'boloto',    word:'Болото',    house:'it'},
  {id:'fialki',    word:'Фиалки',    house:'they'},
  {id:'lyzhi',     word:'Лыжи',      house:'they'},
  {id:'nosilki',   word:'Носилки',   house:'they'}
];

var PRAISE = ['Правильно! Молодец!','Верно! Умница!','Точно! Здорово!','Молодец! Так и есть!','Отлично! Ты справился!'];
var TRY = ['Попробуй ещё раз!','Почти! Подумай ещё.','Ещё разок — и получится!'];

/* ===== состояние ===== */
var queue=[], index=0, attempts=0, locked=false, current=null;
var settled={he:[],she:[],it:[],they:[]};
var timers=[];
var $ = function(id){return document.getElementById(id);};

function later(fn,ms){var t=setTimeout(fn,ms);timers.push(t);return t;}
function clearTimers(){for(var i=0;i<timers.length;i++){clearTimeout(timers[i]);}timers=[];}

function shuffle(arr){
  var a=arr.slice();
  for(var i=a.length-1;i>0;i--){
    var j=Math.floor(Math.random()*(i+1));
    var t=a[i];a[i]=a[j];a[j]=t;
  }
  return a;
}

/* ===== звук (WebAudio, без внешних файлов) ===== */
var actx=null, audioOK=true;
function audio(){
  if(!audioOK) return null;
  try{
    if(!actx){
      var AC=window.AudioContext||window.webkitAudioContext;
      if(!AC){audioOK=false;return null;}
      actx=new AC();
    }
    if(actx.state==='suspended'&&actx.resume){actx.resume();}
    return actx;
  }catch(e){audioOK=false;return null;}
}
function tone(freq,start,dur,vol,type){
  var a=audio(); if(!a) return;
  try{
    var o=a.createOscillator(), g=a.createGain();
    o.type=type||'sine'; o.frequency.value=freq;
    var t0=a.currentTime+ (start||0);
    g.gain.setValueAtTime(0.0001,t0);
    g.gain.exponentialRampToValueAtTime(vol||0.16,t0+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001,t0+dur);
    o.connect(g); g.connect(a.destination);
    o.start(t0); o.stop(t0+dur+0.05);
  }catch(e){}
}
function sfxGood(){tone(523.25,0,0.18,0.14);tone(659.25,0.11,0.18,0.14);tone(783.99,0.22,0.32,0.13);}
function sfxTry(){tone(392,0,0.16,0.10,'triangle');tone(329.63,0.14,0.22,0.09,'triangle');}
function sfxTap(){tone(660,0,0.07,0.07);}
function sfxFinal(){var n=[523.25,659.25,783.99,1046.5,1318.5];for(var i=0;i<n.length;i++){tone(n[i],i*0.13,0.4,0.13);}}

/* ===== речь (если доступна) ===== */
var ttsOK = (typeof window!=='undefined') && ('speechSynthesis' in window) && (typeof window.SpeechSynthesisUtterance==='function');
var voicesReady=false;
function pickRussianVoice(){
  if(!ttsOK) return null;
  try{
    var vs=window.speechSynthesis.getVoices()||[];
    for(var i=0;i<vs.length;i++){if(vs[i]&&vs[i].lang&&vs[i].lang.toLowerCase().indexOf('ru')===0){return vs[i];}}
  }catch(e){}
  return null;
}
if(ttsOK){ try{ window.speechSynthesis.onvoiceschanged=function(){voicesReady=true;}; }catch(e){} }

/* --- записанная озвучка слов (приоритет) --- */
var wordAudio={};
function playRecorded(id){
  var src=AUDIO[id];
  if(!src) return false;
  try{
    var a=wordAudio[id];
    if(!a){
      a=new Audio(src);
      a.preload='auto';
      a.setAttribute('playsinline','');
      wordAudio[id]=a;
    }
    try{a.pause();a.currentTime=0;}catch(e){}
    var p=a.play();
    if(p&&p.catch){p.catch(function(){});}
    return true;
  }catch(e){return false;}
}
function unlockAudio(){
  try{
    if(!SILENT) return;
    var a=new Audio(SILENT);
    a.volume=0;
    var p=a.play();
    if(p&&p.catch){p.catch(function(){});}
  }catch(e){}
}

/* --- произнести слово: сначала запись, потом синтезатор браузера --- */
function speak(text,id){
  if(id&&playRecorded(id)) return true;
  if(!ttsOK) return false;
  try{
    window.speechSynthesis.cancel();
    var u=new SpeechSynthesisUtterance(text);
    u.lang='ru-RU'; u.rate=0.9; u.pitch=1; u.volume=1;
    var v=pickRussianVoice(); if(v){u.voice=v;}
    window.speechSynthesis.speak(u);
    return true;
  }catch(e){return false;}
}

