/* ===== экраны ===== */
function show(id){
  var ss=document.querySelectorAll('.screen');
  for(var i=0;i<ss.length;i++){ss[i].classList.remove('active');}
  $(id).classList.add('active');
}

/* ===== игра ===== */
function resetHouses(){
  settled={he:[],she:[],it:[],they:[]};
  var ts=document.querySelectorAll('[data-tenants]');
  for(var i=0;i<ts.length;i++){ts[i].innerHTML='';}
}

function updateProgress(){
  var n=Math.min(index+1,WORDS.length);
  $('cardNum').textContent=n;
  $('progressFill').style.width=(index/WORDS.length*100)+'%';
}

function startGame(){
  clearTimers();
  queue=shuffle(WORDS);
  index=0; attempts=0; locked=false; current=null;
  resetHouses();
  $('feedback').className='feedback';
  $('feedback').classList.remove('show');
  $('fbMsg').textContent=''; $('fbModel').textContent='';
  updateProgress();
  show('screenGame');
  showCard();
}

function showCard(){
  if(index>=queue.length){ finishGame(); return; }
  current=queue[index];
  attempts=0; locked=false;
  $('cardImg').src=IMAGES[current.id]||'';
  $('cardImg').alt=current.word;
  $('cardRibbon').textContent='Кто это? Что это?';
  $('card').classList.remove('pop','shake');
  $('feedback').className='feedback';
  updateProgress();
  // мягкий «влёт» карточки
  var card=$('card');
  card.style.transform='scale(.9)';card.style.opacity='0';
  requestAnimationFrame(function(){
    card.style.transition='transform .32s cubic-bezier(.2,1.4,.4,1),opacity .32s ease';
    card.style.transform='scale(1)';card.style.opacity='1';
  });
  // название картинки не озвучиваем автоматически: ребёнок называет его сам,
  // а кнопка с динамиком позволяет послушать слово повторно
}

function houseEl(id){return document.querySelector('#houses .house[data-house="'+id+'"]');}

function chooseHouse(id){
  if(locked||!current) return;
  sfxTap();
  if(id===current.house){ goodAnswer(id); }
  else { badAnswer(id); }
}

function goodAnswer(id){
  locked=true;
  var w=current;
  var h=null;
  for(var i=0;i<HOUSES.length;i++){if(HOUSES[i].id===id){h=HOUSES[i];break;}}
  sfxGood();
  // похвала
  $('card').classList.add('pop');
  $('cardRibbon').textContent=w.word;
  $('fbMsg').textContent=PRAISE[Math.floor(Math.random()*PRAISE.length)];
  $('fbModel').textContent=w.word+'. '+h.label.charAt(0)+h.label.slice(1).toLowerCase()+' '+h.my+'.';
  var fb=$('feedback');
  fb.className='feedback show good';

  var target=houseEl(id);
  if(target){target.classList.add('glow');}

  flyToHouse(w,id,function(){
    settled[id].push(w);
    renderTenant(id,w);
  });

  index++;
  updateProgress();

  later(function(){
    if(target){target.classList.remove('glow');}
    if(index>=queue.length){ finishGame(); }
    else {
      fb.classList.remove('show');
      later(function(){ fb.className='feedback'; showCard(); },180);
    }
  },1900);
}

function badAnswer(id){
  attempts++;
  sfxTry();
  var card=$('card');
  card.classList.remove('shake');
  void card.offsetWidth;
  card.classList.add('shake');
  var el=houseEl(id);
  if(el){el.classList.add('bad');later(function(){el.classList.remove('bad');},470);}
  $('fbMsg').textContent=TRY[Math.min(attempts-1,TRY.length-1)];
  $('fbModel').textContent='';
  var fb=$('feedback');
  fb.className='feedback show try';
  if(attempts>=2){
    var hint=houseEl(current.house);
    if(hint){
      hint.classList.remove('hint');
      void hint.offsetWidth;
      hint.classList.add('hint');
      later(function(){hint.classList.remove('hint');},3200);
    }
    $('fbModel').textContent='Посмотри на подсказку 👆';
  }
  later(function(){fb.classList.remove('show');},1600);
}

function renderTenant(houseId,w){
  var box=document.querySelector('[data-tenants="'+houseId+'"]');
  if(!box) return;
  var im=document.createElement('img');
  im.src=IMAGES[w.id]||'';
  im.alt=w.word;
  box.appendChild(im);
}

/* полёт картинки к домику (FLIP) */
function flyToHouse(w,houseId,done){
  var card=$('card');
  var target=houseEl(houseId);
  if(!target||typeof card.animate!=='function'){ if(done) done(); return; }
  var from=card.getBoundingClientRect();
  var to=target.getBoundingClientRect();
  var flyer=document.createElement('div');
  flyer.className='flyer';
  flyer.style.left=from.left+'px';
  flyer.style.top=from.top+'px';
  flyer.style.width=from.width+'px';
  flyer.style.height=from.height+'px';
  var im=document.createElement('img');
  im.src=IMAGES[w.id]||'';
  im.style.width='100%';im.style.height='100%';im.style.objectFit='contain';
  flyer.appendChild(im);
  document.body.appendChild(flyer);

  var dx=(to.left+to.width/2)-(from.left+from.width/2);
  var dy=(to.top+to.height*0.34)-(from.top+from.height/2);
  var scale=Math.max(0.14,Math.min(to.width*0.34/from.width,0.5));
  try{
    var anim=flyer.animate([
      {transform:'translate(0,0) scale(1) rotate(0deg)',opacity:1},
      {transform:'translate('+(dx*0.55)+'px,'+(dy*0.5-40)+'px) scale('+((1+scale)/2)+') rotate(-6deg)',opacity:1,offset:0.55},
      {transform:'translate('+dx+'px,'+dy+'px) scale('+scale+') rotate(4deg)',opacity:0.2}
    ],{duration:820,easing:'cubic-bezier(.35,.1,.3,1)',fill:'forwards'});
    anim.onfinish=function(){ if(flyer.parentNode){flyer.parentNode.removeChild(flyer);} if(done) done(); };
    later(function(){ if(flyer.parentNode){flyer.parentNode.removeChild(flyer);} },1200);
  }catch(e){
    if(flyer.parentNode){flyer.parentNode.removeChild(flyer);}
    if(done) done();
  }
}

/* ===== финал ===== */
function finishGame(){
  clearTimers();
  locked=true;
  var box=$('finalHouses');
  box.innerHTML='';
  for(var i=0;i<HOUSES.length;i++){
    (function(h){
      var el=document.createElement('div');
      el.className='house';
      el.innerHTML=houseSVG(h)+'<div class="tenants" data-tenants="'+h.id+'"></div>';
      box.appendChild(el);
      var list=settled[h.id]||[];
      for(var j=0;j<list.length;j++){
        (function(w,k){
          later(function(){
            var b=el.querySelector('.tenants');
            if(!b) return;
            var im=document.createElement('img');
            im.src=IMAGES[w.id]||'';im.alt=w.word;
            b.appendChild(im);
          },120*k);
        })(list[j],j);
      }
    })(HOUSES[i]);
  }
  show('screenFinal');
  sfxFinal();
  startConfetti();
  later(stopConfetti,9000);
}

/* ===== конфетти ===== */
var confettiRAF=null, confettiParts=[], confettiStart=0;
function startConfetti(){
  var cv=$('confetti');
  var dpr=Math.min(window.devicePixelRatio||1,2);
  function size(){cv.width=Math.floor(window.innerWidth*dpr);cv.height=Math.floor(window.innerHeight*dpr);cv.style.width=window.innerWidth+'px';cv.style.height=window.innerHeight+'px';}
  size();
  window.addEventListener('resize',size);
  var ctx=cv.getContext('2d');
  var colors=['#59b7e8','#57cfae','#ffcf5c','#b79bee','#ff8f86','#ffffff'];
  confettiParts=[];
  for(var i=0;i<150;i++){
    confettiParts.push({
      x:Math.random()*cv.width,
      y:-Math.random()*cv.height,
      w:(8+Math.random()*10)*dpr,
      h:(10+Math.random()*14)*dpr,
      vy:(1.6+Math.random()*2.6)*dpr,
      vx:(-0.7+Math.random()*1.4)*dpr,
      rot:Math.random()*Math.PI,
      vr:(-0.06+Math.random()*0.12),
      c:colors[i%colors.length],
      star:i%5===0
    });
  }
  confettiStart=Date.now();
  function frame(){
    ctx.clearRect(0,0,cv.width,cv.height);
    for(var i=0;i<confettiParts.length;i++){
      var p=confettiParts[i];
      p.y+=p.vy; p.x+=p.vx; p.rot+=p.vr;
      if(p.y>cv.height+20){p.y=-20;p.x=Math.random()*cv.width;}
      ctx.save();
      ctx.translate(p.x,p.y);ctx.rotate(p.rot);
      ctx.fillStyle=p.c;
      if(p.star){
        ctx.beginPath();
        for(var k=0;k<5;k++){
          var a=-Math.PI/2+k*2*Math.PI/5;
          ctx.lineTo(Math.cos(a)*p.w,Math.sin(a)*p.w);
          a+=Math.PI/5;
          ctx.lineTo(Math.cos(a)*p.w*0.45,Math.sin(a)*p.w*0.45);
        }
        ctx.closePath();ctx.fill();
      }else{
        ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);
      }
      ctx.restore();
    }
    if(Date.now()-confettiStart<9000){confettiRAF=requestAnimationFrame(frame);}
    else{ctx.clearRect(0,0,cv.width,cv.height);confettiRAF=null;}
  }
  if(confettiRAF) cancelAnimationFrame(confettiRAF);
  confettiRAF=requestAnimationFrame(frame);
}
function stopConfetti(){
  if(confettiRAF){cancelAnimationFrame(confettiRAF);confettiRAF=null;}
  var cv=$('confetti');
  var ctx=cv.getContext('2d');
  ctx.clearRect(0,0,cv.width,cv.height);
}

/* ===== события ===== */
function bindPress(el){
  if(!el) return;
  el.addEventListener('pointerdown',function(){el.classList.add('pressed');});
  ['pointerup','pointercancel','pointerleave'].forEach(function(ev){
    el.addEventListener(ev,function(){el.classList.remove('pressed');});
  });
}

function init(){
  $('startScene').innerHTML=startSceneSVG();
  buildHouses($('houses'),false);

  // делегирование: работает и для мыши, и для касания
  $('houses').addEventListener('click',function(e){
    var t=e.target;
    while(t&&t!==this&&!t.getAttribute){t=t.parentNode;}
    if(!t||t===this) return;
    var id=t.getAttribute('data-house');
    if(!id){
      var p=t.closest?t.closest('.house'):null;
      if(p){id=p.getAttribute('data-house');}
    }
    if(id){e.preventDefault();chooseHouse(id);}
  });

  $('btnStart').addEventListener('click',function(e){
    e.preventDefault();audio();sfxTap();unlockAudio();
    try{ if(ttsOK){ pickRussianVoice(); } }catch(err){}
    startGame();
  });
  $('btnRestart').addEventListener('click',function(e){e.preventDefault();stopConfetti();sfxTap();startGame();});
  $('btnSpeak').addEventListener('click',function(e){
    e.preventDefault();e.stopPropagation();
    audio();unlockAudio();
    if(!current) return;
    var ok=speak(current.word,current.id);
    if(!ok){sfxTap();$('fbMsg').textContent='Назови слово вслух: '+current.word;$('fbModel').textContent='';
      var fb=$('feedback');fb.className='feedback show try';
      later(function(){fb.classList.remove('show');},1400);}
  });

  bindPress($('btnStart'));bindPress($('btnRestart'));bindPress($('btnSpeak'));

  // запрет контекстного меню и двойного зума на игровых элементах
  document.addEventListener('contextmenu',function(e){e.preventDefault();});
  document.addEventListener('dblclick',function(e){e.preventDefault();});
  document.addEventListener('gesturestart',function(e){e.preventDefault();});
  var lastTouch=0;
  document.addEventListener('touchend',function(e){
    var now=Date.now();
    if(now-lastTouch<300){e.preventDefault();}
    lastTouch=now;
  },{passive:false});
  document.addEventListener('touchmove',function(e){
    if(e.touches.length>1){e.preventDefault();}
  },{passive:false});
}

if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}
else{init();}
})();
</script>
